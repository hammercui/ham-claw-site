---
import {
  ArrowRight,
  CalendarDays,
  Check,
  ChevronDown,
  Download,
  ExternalLink,
  FileCheck2,
  LockKeyhole,
  Menu,
  MessageSquareText,
  MessageSquareWarning,
  PanelsTopLeft,
  PlugZap,
  Settings2,
  ShieldCheck,
  Sparkles,
  Terminal,
  TriangleAlert
} from "lucide-astro";

interface Props {
  name:
    | "alert"
    | "arrow"
    | "calendar"
    | "check"
    | "chevron"
    | "download"
    | "external"
    | "fileCheck"
    | "lock"
    | "menu"
    | "message"
    | "messageWarning"
    | "plug"
    | "settings"
    | "shield"
    | "spark"
    | "terminal"
    | "windows";
  size?: number;
}

const { name, size = 20 } = Astro.props;

const icons = {
  alert: TriangleAlert,
  arrow: ArrowRight,
  calendar: CalendarDays,
  check: Check,
  chevron: ChevronDown,
  download: Download,
  external: ExternalLink,
  fileCheck: FileCheck2,
  lock: LockKeyhole,
  menu: Menu,
  message: MessageSquareText,
  messageWarning: MessageSquareWarning,
  plug: PlugZap,
  settings: Settings2,
  shield: ShieldCheck,
  spark: Sparkles,
  terminal: Terminal,
  windows: PanelsTopLeft
} as const;

const IconComponent = icons[name];
---

<IconComponent aria-hidden="true" class="icon" size={size} stroke-width="1.75" />
