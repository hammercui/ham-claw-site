---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";
---

<BaseLayout title="页面不存在" description="没有找到你访问的龙虾卫士页面。">
  <section class="not-found shell">
    <div>
      <h1>404</h1>
      <p>这个页面不存在，或者已经移动。</p>
      <a class="button button--primary" href={withBase("/")}>返回首页</a>
    </div>
  </section>
</BaseLayout>
