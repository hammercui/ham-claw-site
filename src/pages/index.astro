---
import DownloadAction from "../components/DownloadAction.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";

const workflow = [
  ["安装与运行", "检查环境、安装 OpenClaw，并稳定托管网关。"],
  ["供应商与模型", "接入常用服务，清楚选择默认模型。"],
  ["聊天软件", "配置 Telegram 等通道，并验证真实回复。"],
  ["Skills 与定时任务", "搜索能力、管理依赖，安排自动任务。"]
] as const;

const diagnoses = [
  ["网关未运行", "聊天与 API 暂时不可用", "确认状态后启动服务"],
  ["端口冲突", "网关无法绑定 18789", "确认占用程序后重新检查"],
  ["模型不可用", "请求失败，无法生成回复", "切换模型或确认后最小探针"],
  ["聊天无回复", "通道连接但闭环未确认", "进入 60 秒消息诊断"],
  ["配置无效", "相关功能无法安全生效", "确认后恢复最近安全备份"]
] as const;

const trust = [
  ["网关守护", "识别退出与端口冲突，按安全边界恢复。", "shield"],
  ["配置保护", "写入前备份，写后验证，失败时条件回滚。", "terminal"],
  ["更新校验", "SHA-256 与 minisign 双重验证后才换新。", "check"],
  ["隐私边界", "密钥不进入官网、日志或公开发布元数据。", "spark"]
] as const;
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero__copy">
      <h1>让 OpenClaw<br />稳定运行，人人都能用</h1>
      <p>安装、供应商、聊天软件、Skills、定时任务和故障恢复，一个桌面工具完成。</p>
      <div class="hero__actions">
        <DownloadAction compact />
        <a class="button button--secondary" href={withBase("/guide/")}>查看安装指南</a>
      </div>
      <p class="platform-line">Windows 10/11 · x64 · 单文件运行</p>
    </div>
    <figure class="product-frame hero__product">
      <img
        src={withBase("/assets/product-console.png")}
        width="1454"
        height="950"
        alt="龙虾卫士控制台，显示 OpenClaw 运行状态、环境信息、供应商和聊天软件连接"
        fetchpriority="high"
      />
      <figcaption>真实桌面界面 · 控制台</figcaption>
    </figure>
  </section>

  <section class="section section--soft" id="capabilities">
    <div class="shell">
      <div class="section-heading section-heading--wide">
        <h2>把零散的命令行工作，收进一个桌面工作区</h2>
        <p>围绕日常任务组织入口，不要求用户先理解 Node、JSON 或命令参数。</p>
      </div>
      <div class="workflow-grid" id="workflow">
        <ol class="workflow-list">
          {workflow.map(([title, description], index) => (
            <li class:list={{ "is-current": index === 0 }}>
              <span class="workflow-list__number">{index + 1}</span>
              <div>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="workflow-detail" aria-label="桌面工作流摘要">
          <div class="workflow-detail__bar">
            <span class="window-dot window-dot--red"></span>
            <span class="window-dot window-dot--yellow"></span>
            <span class="window-dot window-dot--green"></span>
            <span>龙虾卫士 · 控制台</span>
          </div>
          <div class="workflow-detail__body">
            <div class="workflow-detail__status">
              <span class="status-light"></span>
              <div><strong>OpenClaw 正在运行</strong><span>网关状态和关键环境集中可见</span></div>
            </div>
            <dl>
              <div><dt>运行环境</dt><dd>版本、Node、默认模型、端口</dd></div>
              <div><dt>常用入口</dt><dd>供应商、聊天软件、Skills、定时任务</dd></div>
              <div><dt>维护工具</dt><dd>稳定中心、日志、安装与升级</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section diagnosis-section">
    <div class="shell diagnosis-grid">
      <div class="section-heading diagnosis-copy">
        <h2>出现问题时，知道原因，也知道下一步</h2>
        <p>五类常见故障进入同一条诊断路径。证据不足时明确显示未知，不用猜。</p>
        <a class="text-link" href={withBase("/guide/#diagnosis")}>了解故障恢复流程 <Icon name="arrow" size={18} /></a>
      </div>
      <div class="diagnosis-table" role="table" aria-label="五类常见故障恢复路径">
        <div class="diagnosis-table__header" role="row">
          <span role="columnheader">问题现象</span>
          <span role="columnheader">影响</span>
          <span role="columnheader">下一步</span>
        </div>
        {diagnoses.map(([problem, impact, action], index) => (
          <div class="diagnosis-row" role="row">
            <span role="cell" class="diagnosis-row__problem">
              <span class={`diagnosis-mark diagnosis-mark--${index + 1}`}></span>{problem}
            </span>
            <span role="cell" data-label="影响">{impact}</span>
            <span role="cell" data-label="下一步" class="diagnosis-row__action">{action}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft" id="trust">
    <div class="shell trust-grid">
      <div class="section-heading trust-copy">
        <h2>稳定，不靠碰运气</h2>
        <p>OpenClaw 的每一次运行、配置和更新，都在可验证、可回滚、可追溯的边界内完成。</p>
      </div>
      <div class="trust-list">
        {trust.map(([title, description, icon]) => (
          <article>
            <span class="trust-list__icon"><Icon name={icon} size={25} /></span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section download-section" id="download">
    <div class="shell download-panel">
      <div>
        <h2>准备好以后，从这里开始</h2>
        <p class="download-panel__status"><Icon name="calendar" size={21} />首个 Windows 公开版本准备中</p>
        <p class="platform-line">Windows 10/11 · x64 · 单文件运行</p>
      </div>
      <div class="download-panel__action">
        <DownloadAction />
        <a class="text-link" href={withBase("/guide/")}>查看安装指南 <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section faq-section" id="faq">
    <div class="shell faq-grid">
      <h2>常见问题</h2>
      <div class="faq-list">
        <details>
          <summary>龙虾卫士会替代 OpenClaw 吗？<Icon name="chevron" size={20} /></summary>
          <p>不会。龙虾卫士是 OpenClaw 的 Windows 桌面控制中心，复用其会话、模型、工具和记忆，不另造第二个 Agent 内核。</p>
        </details>
        <details>
          <summary>为什么只提供 Windows 版？<Icon name="chevron" size={20} /></summary>
          <p>当前版本围绕 Windows 的进程托管、开机自启和单文件运行完成了真实验证。macOS 需要独立适配、签名、公证和真机验收后才会开放。</p>
        </details>
        <details>
          <summary>应用如何确认更新可信？<Icon name="chevron" size={20} /></summary>
          <p>更新包下载后先核对 SHA-256，再使用客户端内置公钥验证 minisign 签名；任一验证失败都不会替换当前应用。</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
